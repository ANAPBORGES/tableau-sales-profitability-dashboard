      <column datatype='integer' name="[Row ID]" role='measure' type='quantitative' />
      <column datatype='string' name="[Order ID]" role='dimension' type='nominal' />
      <column datatype='date' name="[Order Date]" role='dimension' type='ordinal' />
      <column datatype='date' name="[Ship Date]" role='dimension' type='ordinal' />
      <column datatype='string' name="[Ship Mode]" role='dimension' type='nominal' />
      <column datatype='string' name="[Customer ID]" role='dimension' type='nominal' />
      <column datatype='string' name="[Customer Name]" role='dimension' type='nominal' />
      <column datatype='string' name="[Segment]" role='dimension' type='nominal' />
      <column datatype='string' name="[Country]" role='dimension' type='nominal' semantic-role="[Country].[Name]" />
      <column datatype='string' name="[City]" role='dimension' type='nominal' semantic-role="[City].[Name]" />
      <column datatype='string' name="[State]" role='dimension' type='nominal' semantic-role="[State].[Name]" />
      <column datatype='string' name="[Postal Code]" role='dimension' type='nominal' semantic-role="[ZipCode].[Name]" />
      <column datatype='string' name="[Region]" role='dimension' type='nominal' />
      <column datatype='string' name="[Product ID]" role='dimension' type='nominal' />
      <column datatype='string' name="[Category]" role='dimension' type='nominal' />
      <column datatype='string' name="[Sub-Category]" role='dimension' type='nominal' />
      <column datatype='string' name="[Product Name]" role='dimension' type='nominal' />
      <column datatype='real' name="[Sales]" role='measure' type='quantitative' />
      <column datatype='integer' name="[Quantity]" role='measure' type='quantitative' />
      <column datatype='real' name="[Discount]" role='measure' type='quantitative' />
      <column datatype='real' name="[Profit]" role='measure' type='quantitative' />
      <column caption="Profit Ratio" datatype='real' name='[Calculation_100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Profit]) / SUM([Sales])" />
        <desc>
          <formatted-text><run>Backbone metric. Aggregate ratio - SUM/SUM, never AVG of a row-level ratio, which would weight a $5 line the same as a $5,000 one.</run></formatted-text>
        </desc>
      </column>
      <column caption="Profit or Loss" datatype='string' name='[Calculation_101]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN "Loss" ELSE "Profit" END' />
        <desc>
          <formatted-text><run>Flag for diverging colour. Profit has real polarity - a loss is not 'less profit', it is a different fact.</run></formatted-text>
        </desc>
      </column>
      <column caption="Avg Discount" datatype='real' name='[Calculation_102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="AVG([Discount])" />
        <desc>
          <formatted-text><run>Row-level average. For a revenue-weighted version use SUM([Discount]*[Sales])/SUM([Sales]).</run></formatted-text>
        </desc>
      </column>
      <column caption="YoY Sales Growth" datatype='real' name='[Calculation_103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="(SUM([Sales]) - LOOKUP(SUM([Sales]), -1)) / LOOKUP(SUM([Sales]), -1)" />
        <desc>
          <formatted-text><run>Table calculation - set Compute Using to the date axis on the sheet.</run></formatted-text>
        </desc>
      </column>
      <column caption="Running Total of Sales" datatype='real' name='[Calculation_104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="RUNNING_SUM(SUM([Sales]))" />
        <desc>
          <formatted-text><run>Table calculation.</run></formatted-text>
        </desc>
      </column>
      <column caption="Cumulative % of Sales" datatype='real' name='[Calculation_105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="RUNNING_SUM(SUM([Sales])) / TOTAL(SUM([Sales]))" />
        <desc>
          <formatted-text><run>The Pareto curve. Sort sub-categories descending first, or the curve is meaningless.</run></formatted-text>
        </desc>
      </column>
      <column caption="3-Month Moving Average" datatype='real' name='[Calculation_106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="WINDOW_AVG(SUM([Sales]), -2, 0)" />
        <desc>
          <formatted-text><run>Trailing 3-month window: the current month plus the two before it.</run></formatted-text>
        </desc>
      </column>
    </datasource>
  </datasources>
