              <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;1. No discount&quot; ELSEIF [Discount] &lt;= 0.1 THEN &quot;2. Up to 10%&quot; ELSEIF [Discount] &lt;= 0.2 THEN &quot;3. 11-20%&quot; ELSEIF [Discount] &lt;= 0.3 THEN &quot;4. 21-30%&quot; ELSE &quot;5. Over 30%&quot; END' />
