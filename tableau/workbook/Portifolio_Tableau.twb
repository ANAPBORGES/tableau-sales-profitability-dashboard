            <column-instance column='[Calculation_1081400412794880]' derivation='User' name='[usr:Calculation_1081400412794880:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2233413679443968]' derivation='User' name='[usr:Calculation_2233413679443968:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2233413679665155]' derivation='User' name='[usr:Calculation_2233413679665155:qk]' pivot='key' type='quantitative'>
