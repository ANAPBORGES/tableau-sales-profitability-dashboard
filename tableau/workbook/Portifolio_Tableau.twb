      <aliases enabled='yes' />
      <column caption='Total Orders' datatype='integer' name='[Calculation_1081400412794880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='Profit Margin %' datatype='real' default-format='p0.0%' name='[Calculation_2233413679443968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Profit or Loss' datatype='string' name='[Calculation_2233413679505409]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN &quot;Loss&quot; ELSE &quot;Profit&quot; END' />
      </column>
      <column caption='Avg Discount' datatype='real' default-format='p0.0%' name='[Calculation_2233413679591426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='YoY Sales Growth' datatype='real' default-format='p0.0%' name='[Calculation_2233413679665155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1)) / LOOKUP(SUM([Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running Total of Sales' datatype='real' name='[Calculation_2233413679734788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative % of Sales' datatype='real' default-format='p0.0%' name='[Calculation_2233413679775749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales])) / TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='3-Month Moving Average' datatype='real' name='[Calculation_2233413679841286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales]), -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Days to Ship' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_900000000000101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Ship Date])' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_900000000000102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer ID])' />
      </column>
      <column caption='Avg Order Value' datatype='real' default-format='c,0' name='[Calculation_900000000000103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
      <column caption='Revenue per Customer' datatype='real' default-format='c,0' name='[Calculation_900000000000104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Customer ID])' />
      </column>
      <column caption='Discount Band' datatype='string' name='[Calculation_900000000000201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;1. No discount&quot; ELSEIF [Discount] &lt;= 0.1 THEN &quot;2. Up to 10%&quot; ELSEIF [Discount] &lt;= 0.2 THEN &quot;3. 11-20%&quot; ELSEIF [Discount] &lt;= 0.3 THEN &quot;4. 21-30%&quot; ELSE &quot;5. Over 30%&quot; END' />
      </column>
      <column caption='Loss-Making Orders %' datatype='real' default-format='p0.0%' name='[Calculation_900000000000202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Profit] &lt; 0 THEN [Order ID] END) / COUNTD([Order ID])' />
      </column>
      <column caption='Revenue Lost to Discount' datatype='real' default-format='C1033%' name='[Calculation_900000000000203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales] * [Discount])' />
      </column>
      <column caption='Loss from Unprofitable Orders' datatype='real' default-format='C1033%' name='[Calculation_900000000000204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Profit] &lt; 0 THEN [Profit] END)' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='real' default-format='p0.0%' name='[Discount]' role='measure' type='quantitative' />
      <column datatype='string' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
      <column datatype='real' default-format='C1033%' name='[Profit]' role='measure' type='quantitative' />
      <column datatype='real' default-format='C1033%' name='[Sales]' role='measure' type='quantitative' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column caption='superstore.csv' datatype='table' name='[__tableau_internal_object_id__].[superstore.csv_EB1E7C480A4E4778938A3C048B19BC80]' role='measure' type='quantitative' />
      <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
