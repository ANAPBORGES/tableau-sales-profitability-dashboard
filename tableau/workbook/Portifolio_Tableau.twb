    <worksheet name='KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='superstore' name='federated.16w0p6v0q6rwfk17lnc7v18z6fqj' />
          </datasources>
          <datasource-dependencies datasource='federated.16w0p6v0q6rwfk17lnc7v18z6fqj'>
            <column caption='Total Orders' datatype='integer' name='[Calculation_1081400412794880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order ID])' />
            </column>
            <column caption='Profit Margin %' datatype='real' default-format='p0.0%' name='[Calculation_2233413679443968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
            </column>
            <column caption='YoY Sales Growth' datatype='real' default-format='p0.0%' name='[Calculation_2233413679665155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1)) / LOOKUP(SUM([Sales]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Running Total of Sales' datatype='real' name='[Calculation_2233413679734788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cumulative % of Sales' datatype='real' default-format='p0.0%' name='[Calculation_2233413679775749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales])) / TOTAL(SUM([Sales]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
